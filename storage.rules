rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function postPath(postId) {
      return /databases/(default)/documents/posts/$(postId);
    }

    function activeUser() {
      return request.auth != null
        && firestore.exists(userPath())
        && firestore.get(userPath()).data.status == 'active';
    }

    // Ugyanaz a kisbetűs cím, mint a ClubConfig.adminEmail.
    function isAdmin() {
      return activeUser()
        && firestore.get(userPath()).data.role == 'admin'
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'info@sarosigyorgy.hu';
    }

    function isCoach() {
      return activeUser() && firestore.get(userPath()).data.role == 'coach';
    }

    // functions/club-policy.js MEMBERS_MAY_POST. Subli: true.
    function membersMayPost() {
      return true;
    }

    function isPostAuthor(postId) {
      return firestore.exists(postPath(postId))
        && firestore.get(postPath(postId)).data.authorId == request.auth.uid;
    }

    function canReadPostFile(postId) {
      return isAdmin() || (!membersMayPost() && isCoach()) || (
        activeUser()
        && firestore.exists(postPath(postId))
        && (
          firestore.get(postPath(postId)).data.get('audience', ['all']).hasAny(['all'])
          || (
            firestore.get(userPath()).data.role == 'athlete'
            && firestore.get(postPath(postId)).data.get('audience', ['all']).hasAny(['athletes'])
          )
          || (
            firestore.get(userPath()).data.role == 'parent'
            && firestore.get(postPath(postId)).data.get('audience', ['all']).hasAny(['parents'])
          )
        )
      );
    }

    function memberMayWritePost(postId) {
      return activeUser()
        && (
          !firestore.exists(postPath(postId))
          || isPostAuthor(postId)
        );
    }

    function coachMayWritePost(postId) {
      return isCoach()
        && (
          !firestore.exists(postPath(postId))
          || isPostAuthor(postId)
        );
    }

    function isApprovedParent(userId) {
      return activeUser()
        && firestore.get(userPath()).data.role == 'parent'
        && request.auth.uid in firestore.get(/databases/(default)/documents/users/$(userId)).data.get('parentIds', []);
    }

    function allowedDocument() {
      return request.resource != null
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
        ];
    }

    function allowedUpload() {
      return request.resource != null
        && (
          (
            request.resource.contentType.matches('image/.*')
            && request.resource.size <= 10 * 1024 * 1024
          )
          || (
            request.resource.contentType.matches('video/.*')
            && request.resource.size <= 100 * 1024 * 1024
          )
        );
    }

    match /users/{userId}/avatar.jpg {
      allow read: if activeUser();
      allow create, update: if request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 5 * 1024 * 1024
        && (
          isAdmin()
          || request.auth.uid == userId
          || isApprovedParent(userId)
        );
      allow delete: if isAdmin()
        || request.auth.uid == userId
        || isApprovedParent(userId);
    }

    match /posts/{postId}/docs/{fileName} {
      allow read: if canReadPostFile(postId);
      allow create, update: if allowedDocument()
        && (
          isAdmin()
          || (membersMayPost() ? memberMayWritePost(postId) : coachMayWritePost(postId))
        );
      allow delete: if activeUser() && (isAdmin() || isPostAuthor(postId));
    }

    match /posts/{postId}/{fileName} {
      allow read: if canReadPostFile(postId);
      allow create, update: if allowedUpload()
        && (
          isAdmin()
          || (membersMayPost() ? memberMayWritePost(postId) : coachMayWritePost(postId))
        );
      allow delete: if activeUser() && (isAdmin() || isPostAuthor(postId));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
