rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function userPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function postPath(postId) {
      return /databases/(default)/documents/posts/$(postId);
    }

    function activeUser() {
      return request.auth != null
        && firestore.exists(userPath())
        && firestore.get(userPath()).data.status == 'active';
    }

    function isAdmin() {
      return activeUser() && firestore.get(userPath()).data.role == 'admin';
    }

    function isCoach() {
      return activeUser() && firestore.get(userPath()).data.role == 'coach';
    }

    function isPostAuthor(postId) {
      return firestore.exists(postPath(postId))
        && firestore.get(postPath(postId)).data.authorId == request.auth.uid;
    }

    function allowedUpload() {
      return request.resource != null
        && (
          (
            request.resource.contentType.matches('image/.*')
            && request.resource.size <= 10 * 1024 * 1024
          )
          || (
            request.resource.contentType.matches('video/.*')
            && request.resource.size <= 100 * 1024 * 1024
          )
        );
    }

    match /posts/{postId}/{fileName} {
      allow read: if activeUser();
      allow create, update: if activeUser()
        && (isAdmin() || isCoach())
        && allowedUpload();
      allow delete: if activeUser() && (isAdmin() || isPostAuthor(postId));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
