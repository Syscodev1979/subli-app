rules_version = '2';

// Gastroyal Karate SE — users és posts.
// Deploy: firebase deploy --only firestore:rules,firestore:indexes
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function callerPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function callerExists() {
      return signedIn() && exists(callerPath());
    }

    function caller() {
      return get(callerPath()).data;
    }

    function isActiveRole(role) {
      return callerExists()
        && caller().get('status', null) == 'active'
        && caller().get('role', null) == role;
    }

    function isAdmin() {
      return isActiveRole('admin');
    }

    function isCoach() {
      return isActiveRole('coach');
    }

    function isMemberRole(role) {
      return role == 'athlete' || role == 'parent';
    }

    // Hiányzó mező null, így az összehasonlítás nem utasít el egy üres mezőt.
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function hasAllowedKeys() {
      return request.resource.data.keys().hasOnly([
        'id',
        'name',
        'email',
        'role',
        'status',
        'birthDate',
        'photoUrl',
        'childIds',
        'parentIds',
        'childRequests',
        'createdAt',
      ]);
    }

    // Edző csak sportoló vagy szülő fiókot hagyhat jóvá és kapcsolhat össze.
    // A szerep nem változhat: admin és edző dokumentumát csak admin írhatja.
    function coachMayUpdate() {
      return isCoach()
        && isMemberRole(resource.data.get('role', null))
        && isMemberRole(request.resource.data.get('role', null))
        && unchanged('role')
        && unchanged('email')
        && unchanged('id')
        && unchanged('name')
        && unchanged('birthDate')
        && unchanged('photoUrl')
        && unchanged('createdAt')
        && unchanged('childRequests');
    }

    // A saját dokumentumban a szerep, az állapot és a kapcsolatok nem írhatók.
    // A születési dátum pending állapotban még javítható.
    function protectedFieldsUnchanged() {
      return unchanged('role')
        && unchanged('status')
        && unchanged('childIds')
        && unchanged('parentIds')
        && unchanged('id')
        && unchanged('email')
        && (
          resource.data.get('status', null) == 'pending'
          || unchanged('birthDate')
        );
    }

    // Új fiók csak a saját uid-re, pending sportoló vagy szülő lehet.
    function validCreate(userId) {
      let data = request.resource.data;
      return hasAllowedKeys()
        && data.get('id', null) == userId
        && data.get('status', null) == 'pending'
        && data.get('role', null) in ['athlete', 'parent']
        && data.get('childIds', null) is list
        && data.get('childIds', null).size() == 0
        && data.get('parentIds', null) is list
        && data.get('parentIds', null).size() == 0
        && data.get('name', null) is string
        && data.get('name', '').size() > 0
        && data.get('name', '').size() <= 120
        && data.get('email', null) is string
        && data.get('email', null) == request.auth.token.email
        && data.get('createdAt', null) is timestamp
        && (
          data.get('role', null) == 'parent'
          || data.get('birthDate', null) is timestamp
        );
    }

    function isActive() {
      return callerExists() && caller().get('status', null) == 'active';
    }

    function mediaItemOk(item) {
      return item is map
        && item.keys().hasOnly([
          'type', 'url', 'thumbUrl', 'width', 'height', 'durationSec',
        ])
        && item.get('type', null) in ['image', 'video']
        && item.get('url', null) is string
        && item.get('url', '').size() > 0
        && item.get('url', '').size() <= 2000
        && (
          item.get('thumbUrl', null) == null
          || (
            item.get('thumbUrl', null) is string
            && item.get('thumbUrl', '').size() <= 2000
          )
        )
        && (item.get('width', null) == null || item.get('width', null) is int)
        && (item.get('height', null) == null || item.get('height', null) is int)
        && (
          item.get('durationSec', null) == null
          || item.get('durationSec', null) is int
        )
        && (
          item.get('type', null) == 'image'
          || (
            item.get('durationSec', null) is int
            && item.get('durationSec', 0) > 0
            && item.get('durationSec', 0) <= 180
          )
        );
    }

    function mediaIndexOk(media, index) {
      return index >= media.size() || mediaItemOk(media[index]);
    }

    function isVideoAt(media, index) {
      return index < media.size()
        && media[index].get('type', null) == 'video';
    }

    function validMediaList(media) {
      return media is list
        && media.size() <= 10
        && mediaIndexOk(media, 0)
        && mediaIndexOk(media, 1)
        && mediaIndexOk(media, 2)
        && mediaIndexOk(media, 3)
        && mediaIndexOk(media, 4)
        && mediaIndexOk(media, 5)
        && mediaIndexOk(media, 6)
        && mediaIndexOk(media, 7)
        && mediaIndexOk(media, 8)
        && mediaIndexOk(media, 9)
        && (
          (isVideoAt(media, 0) ? 1 : 0)
          + (isVideoAt(media, 1) ? 1 : 0)
          + (isVideoAt(media, 2) ? 1 : 0)
          + (isVideoAt(media, 3) ? 1 : 0)
          + (isVideoAt(media, 4) ? 1 : 0)
          + (isVideoAt(media, 5) ? 1 : 0)
          + (isVideoAt(media, 6) ? 1 : 0)
          + (isVideoAt(media, 7) ? 1 : 0)
          + (isVideoAt(media, 8) ? 1 : 0)
          + (isVideoAt(media, 9) ? 1 : 0)
        ) <= 1;
    }

    function validPostShape() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoUrl',
          'text',
          'createdAt',
          'updatedAt',
          'pinned',
          'category',
          'searchKeywords',
          'media',
        ])
        && data.get('authorId', null) is string
        && data.get('authorName', null) is string
        && data.get('authorName', '').size() > 0
        && data.get('authorName', '').size() <= 120
        && (
          data.get('authorPhotoUrl', null) == null
          || data.get('authorPhotoUrl', null) is string
        )
        && data.get('text', null) is string
        && data.get('text', '').size() <= 5000
        && (
          data.get('text', '').size() > 0
          || data.get('media', []).size() > 0
        )
        && validMediaList(data.get('media', []))
        && data.get('createdAt', null) is timestamp
        && data.get('updatedAt', null) is timestamp
        && data.get('pinned', null) is bool
        && data.get('category', '') in [
          'news',
          'announcement',
          'result',
          'training',
          'event',
        ]
        && data.get('searchKeywords', null) is list
        && data.get('searchKeywords', []).size() <= 200;
    }

    function validCommentShape() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoUrl',
          'text',
          'createdAt',
        ])
        && data.get('authorId', null) == request.auth.uid
        && data.get('authorName', null) is string
        && data.get('authorName', '').size() > 0
        && data.get('authorName', '').size() <= 120
        && (
          data.get('authorPhotoUrl', null) == null
          || data.get('authorPhotoUrl', null) is string
        )
        && data.get('text', null) is string
        && data.get('text', '').size() > 0
        && data.get('text', '').size() <= 1000
        && data.get('createdAt', null) is timestamp;
    }

    function validCheckCreate(userId) {
      let data = request.resource.data;
      return isActive()
        && isSelf(userId)
        && data.keys().hasOnly(['userName', 'createdAt'])
        && data.get('userName', null) is string
        && data.get('userName', '').size() > 0
        && data.get('userName', '').size() <= 120
        && data.get('createdAt', null) is timestamp;
    }

    match /users/{userId} {
      // Pending fiók csak a saját dokumentumát olvassa. Admin és edző mindet.
      allow read: if isSelf(userId) || isAdmin() || isCoach();

      allow create: if isSelf(userId) && validCreate(userId);

      // Szerepkört csak admin módosíthat. Edző jóváhagyhat és összekapcsolhat.
      allow update: if isAdmin()
        || coachMayUpdate()
        || (isSelf(userId) && hasAllowedKeys() && protectedFieldsUnchanged());

      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if isActive();

      allow create: if (isAdmin() || isCoach())
        && request.resource.data.get('authorId', null) == request.auth.uid
        && validPostShape();

      // A szerző az authorId-t és a createdAt-et nem írhatja. Admin bármit,
      // ami az engedélyezett mezők között marad.
      allow update: if validPostShape()
        && (
          isAdmin()
          || (
            isActive()
            && resource.data.get('authorId', null) == request.auth.uid
            && unchanged('authorId')
            && unchanged('createdAt')
          )
        );

      allow delete: if isActive()
        && (
          resource.data.get('authorId', null) == request.auth.uid
          || isAdmin()
        );

      match /checks/{userId} {
        allow read: if isActive();
        allow create: if validCheckCreate(userId);
        allow update: if false;
        allow delete: if isActive()
        && (
          isSelf(userId)
          || isAdmin()
          || get(/databases/$(database)/documents/posts/$(postId)).data.get('authorId', null) == request.auth.uid
        );
      }

      match /reactions/{userId} {
        allow read: if isActive();
        allow create, update: if isActive()
          && isSelf(userId)
          && request.resource.data.keys().hasOnly(['userName', 'type', 'createdAt'])
          && request.resource.data.get('userName', null) is string
          && request.resource.data.get('userName', '').size() > 0
          && request.resource.data.get('userName', '').size() <= 120
          && request.resource.data.get('type', null) in [
            'like', 'heart', 'haha', 'wow', 'sad', 'osu',
          ]
          && request.resource.data.get('createdAt', null) is timestamp;
        allow delete: if isActive()
          && (
            isSelf(userId)
            || isAdmin()
            || get(/databases/$(database)/documents/posts/$(postId)).data.get('authorId', null) == request.auth.uid
          );
      }

      match /comments/{commentId} {
        allow read: if isActive();
        allow create: if isActive() && validCommentShape();
        allow update: if false;
        allow delete: if isActive()
          && (
            resource.data.get('authorId', null) == request.auth.uid
            || isAdmin()
            || isCoach()
          );
      }
    }

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function inConversation(conversationId) {
      return isActive()
        && request.auth.uid in get(conversationPath(conversationId)).data.memberIds;
    }

    function messageShape() {
      let data = request.resource.data;
      return data.keys().hasOnly(['senderId', 'text', 'createdAt', 'deleted'])
        && data.senderId == request.auth.uid
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.createdAt is timestamp
        && data.deleted == false;
    }

    function onlyOwnReadStamp() {
      let before = resource.data.get('lastReadAt', {});
      let after = request.resource.data.get('lastReadAt', {});
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt'])
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && after[request.auth.uid] is timestamp;
    }

    match /members/{memberId} {
      allow read: if isActive();
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if isActive()
        && request.auth.uid in resource.data.memberIds;
      allow create, delete: if false;
      allow update: if isActive()
        && request.auth.uid in resource.data.memberIds
        && onlyOwnReadStamp();

      match /messages/{messageId} {
        allow read: if inConversation(conversationId);
        allow create: if inConversation(conversationId) && messageShape();
        allow update: if inConversation(conversationId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt', 'deleted'])
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.deleted == true
          && request.resource.data.text == '';
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
