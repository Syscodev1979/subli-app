rules_version = '2';

// Subli — users és posts.
// Deploy: firebase deploy --only firestore:rules,firestore:indexes
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function callerPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function callerExists() {
      return signedIn() && exists(callerPath());
    }

    function caller() {
      return get(callerPath()).data;
    }

    function isActiveRole(role) {
      return callerExists()
        && caller().get('status', null) == 'active'
        && caller().get('role', null) == role;
    }

    // Ugyanaz a kisbetűs cím, mint a ClubConfig.adminEmail.
    function adminEmail() {
      return 'info@sarosigyorgy.hu';
    }

    function isDesignatedAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == adminEmail();
    }

    function isAdmin() {
      return isActiveRole('admin') && isDesignatedAdmin();
    }

    function isCoach() {
      return isActiveRole('coach');
    }

    // functions/club-policy.js SIMPLE_MEMBERSHIP. Subli: true.
    function simpleMembership() {
      return true;
    }

    function isMemberRole(role) {
      return role == 'athlete' || role == 'parent';
    }

    // Hiányzó mező null, így az összehasonlítás nem utasít el egy üres mezőt.
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    function hasAllowedKeys() {
      return request.resource.data.keys().hasOnly([
        'id',
        'name',
        'email',
        'role',
        'status',
        'birthDate',
        'photoUrl',
        'childIds',
        'parentIds',
        'childRequests',
        'createdAt',
        'beltRank',
        'requestedRole',
        'groupIds',
        'auditBy',
      ]);
    }

    // Naptári 18. születésnap. A request.time a szabály kiértékelésének ideje.
    function isAtLeast18(birthDate) {
      return birthDate is timestamp
        && (
          request.time.year() - birthDate.year() > 18
          || (
            request.time.year() - birthDate.year() == 18
            && (
              request.time.month() > birthDate.month()
              || (
                request.time.month() == birthDate.month()
                && request.time.day() >= birthDate.day()
              )
            )
          )
        );
    }

    function validBeltRank(value) {
      return value == null || value in [
        'beginner', 'advanced', 'competitor',
      ];
    }

    function validRequestedRole(data) {
      return simpleMembership()
        ? data.get('requestedRole', null) == null
        : data.get('requestedRole', null) == null
          || (
            data.get('requestedRole', null) == 'coach'
            && data.get('role', null) == 'athlete'
          );
    }

    // Edző csak sportoló vagy szülő fiókot hagyhat jóvá és kapcsolhat össze.
    // A szerep nem változhat: admin és edző dokumentumát csak admin írhatja.
    function coachMayUpdate() {
      return !simpleMembership()
        && isCoach()
        && isMemberRole(resource.data.get('role', null))
        && isMemberRole(request.resource.data.get('role', null))
        && unchanged('role')
        && unchanged('email')
        && unchanged('id')
        && unchanged('name')
        && unchanged('birthDate')
        && unchanged('photoUrl')
        && unchanged('createdAt')
        && unchanged('childRequests')
        && unchanged('requestedRole')
        && unchanged('groupIds')
        && resource.data.get('requestedRole', null) != 'coach'
        && resource.data.get('role', null) != 'admin'
        && request.resource.data.get('status', null) != 'suspended'
        && validBeltRank(request.resource.data.get('beltRank', null))
        && (
          unchanged('status')
          || request.resource.data.get('auditBy', null) == request.auth.uid
        );
    }

    // Az admin szerep nem hozható létre és nem vehető el az appból.
    function adminRoleFrozen() {
      return resource.data.get('role', null) == 'admin'
        ? request.resource.data.get('role', null) == 'admin'
        : request.resource.data.get('role', null) != 'admin';
    }

    function adminAccountStaysActive() {
      return resource.data.get('role', null) != 'admin'
        || (
          request.resource.data.get('status', null) == 'active'
          && request.resource.data.get('email', null) == resource.data.get('email', null)
        );
    }

    function sensitiveMemberChange() {
      return !unchanged('role') || !unchanged('status') || !unchanged('groupIds');
    }

    function adminMayUpdate() {
      return isAdmin()
        && hasAllowedKeys()
        && (simpleMembership() ? unchanged('role') : adminRoleFrozen())
        && adminAccountStaysActive()
        && request.resource.data.get('id', null) == resource.data.get('id', null)
        && request.resource.data.get('email', null) == resource.data.get('email', null)
        && unchanged('createdAt')
        && request.resource.data.get('status', null) in [
          'pending', 'active', 'suspended', 'rejected',
        ]
        && request.resource.data.get('groupIds', []) is list
        && request.resource.data.get('groupIds', []).size() <= 20
        && validBeltRank(request.resource.data.get('beltRank', null))
        && (
          unchanged('birthDate')
          || isAtLeast18(request.resource.data.get('birthDate', null))
        )
        && (
          !sensitiveMemberChange()
          || request.resource.data.get('auditBy', null) == request.auth.uid
        );
    }

    // A szülő a gyermeke dokumentumában csak a profilképet cserélheti.
    function parentMayUpdatePhoto() {
      return isActiveRole('parent')
        && request.auth.uid in resource.data.get('parentIds', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrl'])
        && (
          request.resource.data.get('photoUrl', null) == null
          || request.resource.data.get('photoUrl', null) is string
        );
    }

    // A saját dokumentumban a szerep, az állapot és a kapcsolatok nem írhatók.
    // A születési dátum pending állapotban még javítható.
    function protectedFieldsUnchanged() {
      return unchanged('role')
        && unchanged('status')
        && unchanged('childIds')
        && unchanged('parentIds')
        && unchanged('id')
        && unchanged('email')
        && unchanged('beltRank')
        && unchanged('requestedRole')
        && unchanged('groupIds')
        && unchanged('auditBy')
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() >= 2
        && request.resource.data.get('name', '').size() <= 120
        && (
          unchanged('birthDate')
          || (
            resource.data.get('status', null) == 'pending'
            && isAtLeast18(request.resource.data.get('birthDate', null))
          )
        );
    }

    // Új fiók csak a saját uid-re, pending sportoló lehet, legalább 18 évesen.
    // A szülő szerep és a 18 év alatti születési dátum elutasítva.
    function validCreate(userId) {
      let data = request.resource.data;
      return hasAllowedKeys()
        && data.get('id', null) == userId
        && data.get('status', null) == 'pending'
        && (
          simpleMembership()
            ? data.get('role', null) == 'member'
            : data.get('role', null) == 'athlete'
        )
        && data.get('childIds', null) is list
        && data.get('childIds', null).size() == 0
        && data.get('parentIds', null) is list
        && data.get('parentIds', null).size() == 0
        && data.get('name', null) is string
        && data.get('name', '').size() > 0
        && data.get('name', '').size() <= 120
        && data.get('email', null) is string
        && data.get('email', null) == request.auth.token.email
        && data.get('createdAt', null) is timestamp
        && data.get('beltRank', null) == null
        && data.get('groupIds', []).size() == 0
        && validRequestedRole(data)
        && isAtLeast18(data.get('birthDate', null));
    }

    function isActive() {
      return callerExists() && caller().get('status', null) == 'active';
    }

    function officeMime(mime) {
      return mime == 'application/msword'
        || mime == 'application/vnd.ms-excel'
        || mime == 'application/vnd.ms-powerpoint'
        || mime == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || mime == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        || mime == 'application/vnd.openxmlformats-officedocument.presentationml.presentation';
    }

    function visualMediaOk(item) {
      return item.keys().hasOnly([
          'type', 'url', 'thumbUrl', 'width', 'height', 'durationSec',
        ])
        && item.get('type', null) in ['image', 'video']
        && item.get('url', null) is string
        && item.get('url', '').size() > 0
        && item.get('url', '').size() <= 2000
        && (
          item.get('thumbUrl', null) == null
          || (
            item.get('thumbUrl', null) is string
            && item.get('thumbUrl', '').size() <= 2000
          )
        )
        && (item.get('width', null) == null || item.get('width', null) is int)
        && (item.get('height', null) == null || item.get('height', null) is int)
        && (
          item.get('durationSec', null) == null
          || item.get('durationSec', null) is int
        )
        && (
          item.get('type', null) == 'image'
          || (
            item.get('durationSec', null) is int
            && item.get('durationSec', 0) > 0
            && item.get('durationSec', 0) <= 180
          )
        );
    }

    // A kifejezéshatár miatt a méret a Storage szabályon és a kliensen múlik.
    // A letöltési cím hosszát a kliens és a Storage szabály tartja kordában.
    function documentMediaOk(item) {
      return item.get('name', '').size() > 0
        && (
          item.get('mimeType', '') == 'application/pdf'
          || officeMime(item.get('mimeType', ''))
        );
    }

    function mediaIndexOk(media, index) {
      return index >= media.size()
        || media[index].get('type', null) == 'document' && documentMediaOk(media[index])
        || media[index].get('type', null) != 'document' && visualMediaOk(media[index]);
    }

    function isVideoAt(media, index) {
      return index < media.size()
        && media[index].get('type', null) == 'video';
    }

    function isDocumentAt(media, index) {
      return index < media.size()
        && media[index].get('type', null) == 'document';
    }

    function validMediaList(media) {
      return media is list
        && media.size() <= 10
        && (
          (isVideoAt(media, 0) ? 1 : 0)
          + (isVideoAt(media, 1) ? 1 : 0)
          + (isVideoAt(media, 2) ? 1 : 0)
          + (isVideoAt(media, 3) ? 1 : 0)
          + (isVideoAt(media, 4) ? 1 : 0)
          + (isVideoAt(media, 5) ? 1 : 0)
          + (isVideoAt(media, 6) ? 1 : 0)
          + (isVideoAt(media, 7) ? 1 : 0)
          + (isVideoAt(media, 8) ? 1 : 0)
          + (isVideoAt(media, 9) ? 1 : 0)
        ) <= 1
        && (
          (isDocumentAt(media, 0) ? 1 : 0)
          + (isDocumentAt(media, 1) ? 1 : 0)
          + (isDocumentAt(media, 2) ? 1 : 0)
          + (isDocumentAt(media, 3) ? 1 : 0)
          + (isDocumentAt(media, 4) ? 1 : 0)
          + (isDocumentAt(media, 5) ? 1 : 0)
          + (isDocumentAt(media, 6) ? 1 : 0)
          + (isDocumentAt(media, 7) ? 1 : 0)
          + (isDocumentAt(media, 8) ? 1 : 0)
          + (isDocumentAt(media, 9) ? 1 : 0)
        ) <= 5
        && mediaIndexOk(media, 0)
        && mediaIndexOk(media, 1)
        && mediaIndexOk(media, 2)
        && mediaIndexOk(media, 3)
        && mediaIndexOk(media, 4)
        && mediaIndexOk(media, 5)
        && mediaIndexOk(media, 6)
        && mediaIndexOk(media, 7)
        && mediaIndexOk(media, 8)
        && mediaIndexOk(media, 9);
    }

    function validPostShape() {
      let data = request.resource.data;
      let authorName = data.get('authorName', null);
      let body = data.get('text', null);
      return data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoUrl',
          'text',
          'createdAt',
          'updatedAt',
          'pinned',
          'category',
          'searchKeywords',
          'media',
          'eventStartsAt',
          'eventEndsAt',
          'audience',
        ])
        && data.get('authorId', null) is string
        && authorName is string
        && authorName.size() > 0
        && authorName.size() <= 120
        && (
          data.get('authorPhotoUrl', null) == null
          || data.get('authorPhotoUrl', null) is string
        )
        && body is string
        && body.size() <= 5000
        && (
          body.size() > 0
          || data.get('media', []).size() > 0
        )
        && validMediaList(data.get('media', []))
        && data.get('createdAt', null) is timestamp
        && data.get('updatedAt', null) is timestamp
        && data.get('pinned', null) is bool
        && data.get('category', '') in [
          'post',
          'announcement',
          'event',
          'horses',
        ]
        && data.get('searchKeywords', null) is list
        && data.get('searchKeywords', []).size() <= 200
        // Az esemény kezdete kötelező. A vége sorrendjét a kliens ellenőrzi,
        // mert a dokumentumos frissítés már a kifejezéshatár közelében van.
        && (
          data.get('category', '') != 'event'
          || data.get('eventStartsAt', null) is timestamp
        )
        && audienceOk();
    }

    // Subli: csak a „Minden tag”. A Gastroyal a teljes listát engedi.
    // Ugyanaz a szándék, mint a functions/club-policy.js ONLY_ALL_AUDIENCE.
    function onlyAllAudience() {
      return true;
    }

    function audienceOk() {
      let audience = request.resource.data.get('audience', []);
      return onlyAllAudience()
        ? audience.size() == 1 && audience.hasOnly(['all'])
        : audience.hasOnly(['all', 'staff', 'parents', 'athletes'])
          && audience.size() > 0
          && (audience.size() == 1 || !audience.hasAny(['all']));
    }

    // Admin és edző mindig. Más aktív tag csak az „all” vagy a saját szerepe
    // szerint olvas. Hiányzó audience minden tagnak szól.
    function canReadPostData(data) {
      let role = caller().get('role', '');
      return caller().get('status', '') == 'active'
        && (
          isAdmin()
          || role == 'coach'
          || data.get('audience', ['all']).hasAny(['all'])
          || (role == 'athlete' && data.get('audience', ['all']).hasAny(['athletes']))
          || (role == 'parent' && data.get('audience', ['all']).hasAny(['parents']))
        );
    }

    function canReadPost(postId) {
      return canReadPostData(
        get(/databases/$(database)/documents/posts/$(postId)).data
      );
    }

    function validCommentShape() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoUrl',
          'text',
          'createdAt',
        ])
        && data.get('authorId', null) == request.auth.uid
        && data.get('authorName', null) is string
        && data.get('authorName', '').size() > 0
        && data.get('authorName', '').size() <= 120
        && (
          data.get('authorPhotoUrl', null) == null
          || data.get('authorPhotoUrl', null) is string
        )
        && data.get('text', null) is string
        && data.get('text', '').size() > 0
        && data.get('text', '').size() <= 1000
        && data.get('createdAt', null) is timestamp;
    }

    function validCheckCreate(userId) {
      let data = request.resource.data;
      return isActive()
        && isSelf(userId)
        && data.keys().hasOnly(['userName', 'createdAt'])
        && data.get('userName', null) is string
        && data.get('userName', '').size() > 0
        && data.get('userName', '').size() <= 120
        && data.get('createdAt', null) is timestamp;
    }

    match /users/{userId} {
      // Pending fiók csak a saját dokumentumát olvassa. Admin és edző mindet.
      allow read: if isSelf(userId) || isAdmin() || isCoach();

      allow create: if isSelf(userId) && validCreate(userId);

      // Szerepkört csak admin módosíthat. Edző jóváhagyhat és összekapcsolhat.
      allow update: if adminMayUpdate()
        || coachMayUpdate()
        || parentMayUpdatePhoto()
        || (isSelf(userId) && hasAllowedKeys() && protectedFieldsUnchanged());

      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if canReadPostData(resource.data);

      allow create: if (isAdmin() || isCoach())
        && request.resource.data.get('authorId', null) == request.auth.uid
        && validPostShape();

      // A szerző az authorId-t és a createdAt-et nem írhatja. Admin bármit,
      // ami az engedélyezett mezők között marad.
      allow update: if validPostShape()
        && isActive()
        && (
          isAdmin()
          || (
            resource.data.get('authorId', null) == request.auth.uid
            && unchanged('authorId')
            && unchanged('createdAt')
          )
        );

      allow delete: if isActive()
        && (
          resource.data.get('authorId', null) == request.auth.uid
          || isAdmin()
        );

      match /checks/{userId} {
        allow read: if isActive();
        allow create: if validCheckCreate(userId);
        allow update: if false;
        allow delete: if isActive()
        && (
          isSelf(userId)
          || isAdmin()
          || get(/databases/$(database)/documents/posts/$(postId)).data.get('authorId', null) == request.auth.uid
        );
      }

      match /reactions/{userId} {
        allow read: if canReadPost(postId);
        allow create, update: if canReadPost(postId)
          && isSelf(userId)
          && request.resource.data.keys().hasOnly(['userName', 'type', 'createdAt'])
          && request.resource.data.get('userName', null) is string
          && request.resource.data.get('userName', '').size() > 0
          && request.resource.data.get('userName', '').size() <= 120
          && request.resource.data.get('type', null) in [
            'like', 'heart', 'haha', 'wow', 'sad', 'horse',
          ]
          && request.resource.data.get('createdAt', null) is timestamp;
        allow delete: if canReadPost(postId)
          && (
            isSelf(userId)
            || isAdmin()
            || get(/databases/$(database)/documents/posts/$(postId)).data.get('authorId', null) == request.auth.uid
          );
      }

      match /comments/{commentId} {
        allow read: if canReadPost(postId);
        allow create: if canReadPost(postId) && validCommentShape();
        allow update: if false;
        allow delete: if canReadPost(postId)
          && (
            resource.data.get('authorId', null) == request.auth.uid
            || isAdmin()
            || isCoach()
          );
      }
    }

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    function inConversation(conversationId) {
      return isActive()
        && request.auth.uid in get(conversationPath(conversationId)).data.memberIds;
    }

    function messageShape() {
      let data = request.resource.data;
      return data.keys().hasOnly(['senderId', 'text', 'createdAt', 'deleted'])
        && data.senderId == request.auth.uid
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.createdAt is timestamp
        && data.deleted == false;
    }

    function onlyOwnReadStamp() {
      let before = resource.data.get('lastReadAt', {});
      let after = request.resource.data.get('lastReadAt', {});
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt'])
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && after[request.auth.uid] is timestamp;
    }

    function validGroup() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'color', 'description', 'createdAt'])
        && data.get('name', null) is string
        && data.get('name', '').size() > 0
        && data.get('name', '').size() <= 80
        && data.get('color', null) is string
        && data.get('color', '').size() == 7
        && (
          data.get('description', null) == null
          || data.get('description', null) is string
        )
        && data.get('createdAt', null) is timestamp;
    }

    match /groups/{groupId} {
      allow read: if isActive();
      allow create: if isAdmin() && validGroup();
      allow update: if isAdmin() && validGroup() && unchanged('createdAt');
      allow delete: if false;
    }

    match /adminLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /members/{memberId} {
      allow read: if isActive();
      allow write: if false;
    }

    // functions/club-policy.js ALLOW_GROUP_CHATS. Subli: false.
    function groupChatsAllowed() {
      return false;
    }

    function conversationSizeAllowed() {
      return groupChatsAllowed()
        || request.resource.data.get('memberIds', []).size() <= 2;
    }

    match /conversations/{conversationId} {
      allow read: if isActive()
        && request.auth.uid in resource.data.memberIds;
      // A beszélgetést a Cloud Function hozza létre. A kliens sem kétszemélyes,
      // sem csoportos chatet nem írhat. A 2-nél több tag külön is tilos,
      // és meglévő chathez sem adható új tag.
      allow create: if conversationSizeAllowed() && false;
      allow delete: if false;
      allow update: if isActive()
        && request.auth.uid in resource.data.memberIds
        && onlyOwnReadStamp()
        && request.resource.data.memberIds == resource.data.memberIds;

      match /messages/{messageId} {
        allow read: if inConversation(conversationId);
        allow create: if inConversation(conversationId) && messageShape();
        allow update: if inConversation(conversationId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt', 'deleted'])
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.deleted == true
          && request.resource.data.text == '';
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
